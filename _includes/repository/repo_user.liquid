<div class="repo p-2 text-center">
  <a href="https://github.com/{{ include.username }}">
    <img
      class="repo-img-light w-100"
      alt="{{ include.username }}"
      src="/assets/img/github-stats/stats-{{ include.username }}-{{ site.repo_theme_light }}.svg"
    >
    <img
      class="repo-img-dark w-100"
      alt="{{ include.username }}"
      src="/assets/img/github-stats/stats-{{ include.username }}-{{ site.repo_theme_dark }}.svg"
    >
  </a>
</div>
